EXPERIMENT 9 — Huffman Coding
clc; clear; close all;

symbols = 1:8;
prob = [0.22 0.2 0.18 0.15 0.1 0.08 0.05 0.02];

dict = huffmandict(symbols,prob);

msg = randsrc(50,1,[symbols;prob]);

enc = huffmanenco(msg,dict);
dec = huffmandeco(enc,dict);

disp(enc');
disp(dec');

EXPERIMENT 10 — Morphological Operations
clc; clear; close all;

img = im2gray(imread('/MATLAB Drive/sampleimage.jpg'));
bw = imbinarize(img);

se = strel('square',3);

dil = imdilate(bw,se);
ero = imerode(bw,se);
opn = imopen(bw,se);
cls = imclose(bw,se);

figure;
subplot(2,2,1), imshow(dil), title('Dilate');
subplot(2,2,2), imshow(ero), title('Erode');
subplot(2,2,3), imshow(opn), title('Open');
subplot(2,2,4), imshow(cls), title('Close');
